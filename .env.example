# Nigoh — asosiy tizim sozlamalari. Nusxa oling: .env
# (.env gitga tushmaydi — kalitlar shu yerda qoladi)

# Kamera mikroservisi (nigoh-servis) — MAJBURIY
NIGOH_URL=https://negoh.das-uty.uz
NIGOH_KEY=mikroservisning-NIGOH_API_KEY-qiymati

# Sayt porti (standart 8010)
#PORT=8010

# Anonim ko'rish: 1 — xarita hammaga ochiq, 0 — faqat tizimga kirganlar
#PUBLIC_VIEW=1

# Birinchi ishga tushishda admin paroli (bo'lmasa tasodifiy yaratiladi)
#ADMIN_PAROL=

# SHU tizimning o'z server-to-server kaliti (mikroservis kaliti EMAS)
#NIGOH_API_KEY=

# Telegram ogohlantirishlari (kamera uzildi/qaytdi)
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
