# Nigoh sozlamalari — .env nomi bilan nusxalang: cp .env.example .env
# Bu fayl (.env) gitga tushmaydi.

# Birinchi ishga tushirishda yaratiladigan super-admin paroli.
# Berilmasa tasodifiy parol yaratiladi va konteyner logiga chiqadi
# (docker logs nigoh). Kamida 6 belgi.
ADMIN_PAROL=

# Super-admin logini (standart: admin)
#ADMIN_LOGIN=admin

# Sayt porti (standart: 8010)
#PORT=8010

# Anonim ko'rish: 1 — xarita va oqimlar hammaga ochiq (standart);
# 0 — faqat tizimga kirganlar ko'radi (admin hammasini, operator o'z
# hududlarini).
#PUBLIC_VIEW=1

# Brauzer video uchun ulanadigan manzil. Bo'sh qolsa so'rov manzilidan
# olinadi (odatda shu to'g'ri). Server NAT/proksi ortida bo'lsa tashqi
# IP yoki domenni yozing.
#MEDIA_HOST=

# Telegram ogohlantirishlari (ixtiyoriy): kamera uzildi/qaytdi,
# oqim muzladi, MediaMTX qayta ishga tushdi.
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=

# MediaMTX portlari (standartlari odatda yetarli)
#HLS_PORT=8888
#WEBRTC_PORT=8889
#MEDIAMTX_RTSP_PORT=8554
